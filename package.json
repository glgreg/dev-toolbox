{
  "name": "dev-gregorium-com",
  "version": "1.0.0",
  "description": "Gregorium Developer Portal",
  "type": "module",
  "scripts": {
    "start": "vercel dev",
    "deploy": "vercel deploy --prod",
    "lint:jsdoc": "eslint \"dist/**/*.js\" \"worker/**/*.js\" && tsc --noEmit",
    "lint:ts": "eslint \"**/*.ts\"",
    "lint": "npm run lint:jsdoc && npm run lint:ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vercel": "^54.18.6",
    "vitest": "^5.1.0"
  }
}
